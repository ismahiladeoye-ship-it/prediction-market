# --- Runtime ---
NODE_ENV=development
PORT=8080
MONGODB_URI=mongodb://127.0.0.1:27017/scrollme

# --- Auth (generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))") ---
JWT_SECRET=replace-with-a-long-random-value
REFRESH_TOKEN_SECRET=replace-with-a-different-long-random-value
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=12

# --- Browser access ---
# Comma-separated origins allowed to call the API with cookies.
CLIENT_ORIGINS=http://localhost:3000
# Public URL of the storefront (used in payment return links and emails).
APP_URL=http://localhost:3000
# Cookies: Secure defaults to true when NODE_ENV=production. Use SameSite=none only
# when the API and storefront are on different sites (requires HTTPS).
# COOKIE_SECURE=true
COOKIE_SAMESITE=lax
# Number of reverse proxies in front of the API (for client IPs / rate limiting).
TRUST_PROXY=loopback
RATE_LIMIT_ENABLED=true

# --- Pricing (major currency units) ---
CURRENCY=usd
TAX_RATE=0
SHIPPING_STANDARD=20
SHIPPING_EXPRESS=40
# 0 disables free standard shipping
FREE_SHIPPING_THRESHOLD=0
# Minutes stock is held for an unpaid order (Stripe sessions need >= 30)
RESERVATION_MINUTES=35

# --- Payments ---
# stripe (test keys sk_test_...) or mock (local development only; refused in production)
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Live keys are refused unless this is true.
STRIPE_ALLOW_LIVE=false

# --- Optional integrations ---
# Firebase project id enables "Sign in with Google" verification.
FIREBASE_PROJECT_ID=
# e.g. smtps://user:pass@smtp.example.com:465 — without it, dev logs emails to stdout.
SMTP_URL=
MAIL_FROM=ScrollMe <no-reply@example.com>
LOG_LEVEL=info
