# Copy to .env.local for local overrides. All values are optional.

# API base URL. Default "/api": in development CRA proxies it to http://localhost:8080
# (see "proxy" in package.json); in production nginx proxies it to the API container.
# REACT_APP_API_URL=/api

# Currency shown in the storefront (must match the API's CURRENCY).
# REACT_APP_CURRENCY_SYMBOL=£

# Firebase web config — enables "Sign in with Google". Leave empty to hide the button.
# The API must also set FIREBASE_PROJECT_ID to the same project.
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_APP_ID=
