# Copy to ".env" in this folder and fill in. Keep this file private; never commit .env.
# See docs/ORACLE.md.

# Your domain, pointed at the server's public IP (needed for HTTPS).
DOMAIN=shop.example.com

# Database password (any long random value, e.g. `openssl rand -hex 24`).
MONGO_PASSWORD=change-me-to-a-long-random-value

# Three DIFFERENT random values, each 32+ characters (`openssl rand -hex 32`).
JWT_SECRET=
REFRESH_TOKEN_SECRET=
MFA_SECRET_KEY=

# Stripe (test keys first: sk_test_… and the webhook signing secret whsec_…).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Set to true only once you switch to live keys and have tested in test mode.
STRIPE_ALLOW_LIVE=false

# Email (needed before launch). e.g. smtps://user:pass@smtp.example.com:465
SMTP_URL=
MAIL_FROM=Get It Sourced <orders@shop.example.com>
# Optional: where new-order and contact alerts go (default: the Shop details email).
# NOTIFY_EMAIL=orders@shop.example.com
